# Build context: repo root. `docker build -f infra/docker/Dockerfile.api -t namma-seva-api .`
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @namma-seva/api build \
 && pnpm --filter @namma-seva/api deploy --prod --legacy /out

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /out/node_modules ./node_modules
COPY --from=build /out/package.json ./package.json
COPY --from=build /app/apps/api/dist ./dist
USER node
EXPOSE 3001
CMD ["node", "--enable-source-maps", "dist/index.mjs"]
