# Build context: repo root. `docker build -f infra/docker/Dockerfile.api -t namma-seva-api .`
# One image, three processes (plan §9.3 — the indexer is a separate singleton process):
#   API       node dist/index.mjs            (default CMD)
#   indexer   node dist/indexer.mjs run      (exactly one replica per network; advisory-locked)
#   migrate   node dist/migrate.mjs --seed   (release step, before API/indexer start)
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @namma-seva/api build \
 && pnpm --filter @namma-seva/api deploy --prod --legacy /out

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /out/node_modules ./node_modules
COPY --from=build /out/package.json ./package.json
COPY --from=build /app/apps/api/dist ./dist
USER node
EXPOSE 3001
CMD ["node", "--enable-source-maps", "dist/index.mjs"]
