# Build context: repo root. `docker build -f infra/docker/Dockerfile.web -t namma-seva-web .`
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
COPY . .
ARG VITE_NS_CHAIN=mstTestnet
ARG VITE_NS_EXPLORER_URL=
ARG VITE_NS_IPFS_GATEWAY=
ENV VITE_NS_CHAIN=$VITE_NS_CHAIN \
    VITE_NS_EXPLORER_URL=$VITE_NS_EXPLORER_URL \
    VITE_NS_IPFS_GATEWAY=$VITE_NS_IPFS_GATEWAY
RUN pnpm install --frozen-lockfile && pnpm --filter @namma-seva/web build

FROM nginx:1.29-alpine
# Static assets only; the CSP/host settings below are applied at container start (envsubst).
COPY infra/docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY infra/docker/ns-proxy.conf /etc/nginx/ns-proxy.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
ENV NS_SERVER_NAME=_ \
    CSP_CONNECT_EXTRA="https://testnetrpc.mstblockchain.com" \
    CSP_IMG_EXTRA=""
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -q --spider http://127.0.0.1/ || exit 1
