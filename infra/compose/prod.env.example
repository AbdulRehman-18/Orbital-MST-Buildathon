# Copy to prod.env (git-ignored). Values here are read by compose AND passed to the API/indexer.
# See .env.example at the repo root for every variable and its meaning.

REGISTRY=ghcr.io/your-org
TAG=latest
NS_SERVER_NAME=nammaseva.example.org
WEB_PORT=8080

POSTGRES_PASSWORD=
REDIS_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# ---- API / indexer ----
NS_CHAIN=mstTestnet                    # mstMainnet only after the go/no-go (docs/pilot/mainnet-go-no-go.md)
MST_RPC_URLS=https://testnetrpc.mstblockchain.com
CSP_CONNECT_EXTRA=https://testnetrpc.mstblockchain.com
CSP_IMG_EXTRA=https://your-gateway.mypinata.cloud
PUBLIC_BASE_URL=https://nammaseva.example.org
CORS_ORIGINS=https://nammaseva.example.org
SIWE_DOMAIN=nammaseva.example.org
JWT_SECRET=
PHONE_HASH_PEPPER=
OTP_PROVIDER=msg91
OTP_API_KEY=
OTP_TEMPLATE_ID=
PINATA_JWT=
PINATA_GATEWAY=https://your-gateway.mypinata.cloud
METRICS_TOKEN=                          # same value as infra/secrets/metrics_token

# Relayer custody: KMS on mainnet (required), hot key acceptable on testnet only.
RELAYER_KMS_KEY_ID=
RELAYER_KMS_HMAC_KEY_ID=
AWS_REGION=ap-south-1
# RELAYER_PRIVATE_KEY=                  # testnet only; refused when NS_CHAIN=mstMainnet
RELAYER_DAILY_CAP=50
RELAYER_MIN_BALANCE=10

# ---- DPDP / transparency page ----
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=
AUDIT_REPORT_URL=
PILOT_NAME=

BACKUP_KEEP_DAYS=14
