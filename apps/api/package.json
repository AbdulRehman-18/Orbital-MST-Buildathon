{
  "name": "@namma-seva/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "start:indexer": "node --enable-source-maps ./dist/indexer.mjs",
    "indexer": "tsx src/indexer/main.ts run",
    "indexer:dev": "tsx watch src/indexer/main.ts run",
    "indexer:rebuild": "tsx src/indexer/main.ts rebuild",
    "indexer:checksum": "tsx src/indexer/main.ts checksum",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node --enable-source-maps ./dist/migrate.mjs",
    "demo:seed": "tsx src/demo/seed.ts"
  },
  "dependencies": {
    "@namma-seva/api-zod": "workspace:*",
    "@namma-seva/chain": "workspace:*",
    "@namma-seva/db": "workspace:*",
    "bullmq": "^6.3.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "ethers": "^6.17.0",
    "exifr": "^7.1.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "rate-limit-redis": "^6.0.1",
    "sharp": "^0.35.5",
    "siwe": "^3.0.0",
    "socket.io": "^4.8.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.25.9",
    "pino-pretty": "^13.1.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "tsx": "catalog:",
    "vitest": "^5.0.2"
  }
}
