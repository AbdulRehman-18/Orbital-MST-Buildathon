# Copy to .env (git-ignored). Never commit real values.
# Per-role private keys (PRIVKEY_*) from DecentraliTrack are intentionally gone:
# officials, auditors and contractors sign with their own wallets.

# ---- General ----
NODE_ENV=development
NS_DEMO_MODE=false                     # demo role cards + offline boot; refused in production
PORT=3001
LOG_LEVEL=info
TRUST_PROXY=0                          # reverse-proxy hops in front of the API (nginx = 1)
WEB_PORT=5173
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- Chain ----
NS_CHAIN=mstTestnet                    # local | mstTestnet | mstMainnet
MST_RPC_URLS=https://testnetrpc.mstblockchain.com
MST_WS_URL=wss://testnetrpc.mstblockchain.com
MST_CHAIN_ID=91562037
MST_EXPLORER_URL=https://testnet.mstscan.com
CONFIRMATIONS=6
INDEXER_BATCH_SIZE=2000                # halves automatically on RPC range errors (ADR 0004)
INDEXER_POLL_MS=3000
REORG_DEPTH=64                         # blocks rolled back + replayed when a reorg is detected
NS_DEPLOYMENT_FILE=                    # optional override of packages/chain/deployments/<network>.json
RELAYER_PRIVATE_KEY=                   # the ONLY server key: gasless citizen actions (needs RELAYER_ROLE); KMS in prod
RELAYER_KMS_KEY_ID=                    # AWS KMS ECC_SECG_P256K1 key that signs relayer txs (mainnet: required)
RELAYER_KMS_HMAC_KEY_ID=               # AWS KMS HMAC_256 key that derives per-citizen keys (set together with the above)
AWS_REGION=ap-south-1
# RELAYER_KMS_ENDPOINT=                # LocalStack / VPC endpoint override
RELAYER_MIN_BALANCE=10                 # alert below this many MSTC
RELAYER_DAILY_CAP=50                   # MSTC of relayer gas per UTC day before gasless submissions pause
RELAYER_GAS_BUMP_AFTER_MS=60000        # replace-by-nonce with +25% fees if not mined in time
CITIZEN_DAILY_TX_LIMIT=10              # grievances + upvotes per verified phone per 24 h
DEPLOYER_PRIVATE_KEY=                  # packages/contracts only — never read by the API
MST_TESTNET_RPC=https://testnetrpc.mstblockchain.com   # Hardhat config variables (packages/contracts)
MST_MAINNET_RPC=https://mariorpc.mstblockchain.com

# ---- Data ----
DATABASE_URL=postgresql://ns_user:change_me@localhost:5432/nammaseva
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_SECRET=                            # ≥ 32 chars; required in production
SIWE_DOMAIN=localhost:5173             # must equal the domain in the wallet sign-in message
OTP_PROVIDER=console                   # msg91 | twilio | console (dev only: logs the code)
OTP_API_KEY=                           # MSG91 authkey, or Twilio auth token
OTP_TEMPLATE_ID=                       # MSG91 DLT template id
OTP_SENDER=                            # Twilio "From" number
TWILIO_ACCOUNT_SID=
PHONE_HASH_PEPPER=                     # citizen id = sha256(phone + pepper); never change after launch

# ---- IPFS ----
PINATA_JWT=                            # unset in dev → in-memory IPFS store served at /api/ipfs/:cid
PINATA_GATEWAY=https://<your-gateway>.mypinata.cloud
IPFS_BACKUP_PIN_URL=

# ---- Privacy, compliance and operations (Phase 6) ----
CONSENT_VERSION=2026-10-01             # must equal `consent.version` in packages/i18n (bump when the notice changes)
GRIEVANCE_OFFICER_NAME=                # DPDP Act grievance officer — shown on /transparency and /privacy
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=
AUDIT_REPORT_URL=                      # link to the published external audit report
PILOT_NAME=                            # e.g. "Ward 150 pilot"
AUDIT_LOG_RETENTION_DAYS=180           # CERT-In minimum; lower values are refused
METRICS_TOKEN=                         # bearer token for GET /metrics (Prometheus); the route is off in production without it
# RATE_LIMIT_API_PER_MIN=300           # per client IP (3000 in demo mode)
# RATE_LIMIT_AUTH_PER_MIN=30           # per client IP (300 in demo mode)

# ---- Frontend (Vite — only VITE_NS_* is exposed to the browser) ----
VITE_NS_CHAIN=mstTestnet
VITE_NS_API_URL=http://localhost:3001
VITE_NS_EXPLORER_URL=https://testnet.mstscan.com
VITE_NS_IPFS_GATEWAY=https://<your-gateway>.mypinata.cloud
VITE_NS_WALLETCONNECT_PROJECT_ID=
