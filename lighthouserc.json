{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm --filter @namma-seva/web exec vite preview --port 4173 --strictPort",
      "startServerReadyPattern": "Local:",
      "url": ["http://localhost:4173/", "http://localhost:4173/projects", "http://localhost:4173/transparency"],
      "numberOfRuns": 3,
      "settings": { "formFactor": "mobile", "onlyCategories": ["performance", "accessibility", "best-practices", "seo"] }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
