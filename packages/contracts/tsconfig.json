{
  "compilerOptions": {
    "lib": [
      "es2023"
    ],
    "module": "node20",
    "target": "es2023",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node",
      "mocha"
    ],
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "hardhat.config.ts",
    "scripts",
    "test",
    "types"
  ]
}
