{
  "name": "@namma-seva/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat build && pnpm run check:opcodes",
    "compile": "hardhat build",
    "check:opcodes": "node --experimental-strip-types --no-warnings scripts/checkOpcodes.ts",
    "test": "hardhat test",
    "test:sol": "hardhat test solidity",
    "test:ts": "hardhat test mocha",
    "coverage": "hardhat test --coverage",
    "gas": "hardhat test mocha --gas-stats",
    "typecheck": "hardhat build && tsc --noEmit",
    "node": "hardhat node",
    "export-abis": "hardhat run scripts/exportAbis.ts",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:mst-testnet": "hardhat run scripts/deploy.ts --network mstTestnet",
    "deploy:mst-mainnet": "hardhat run scripts/deploy.ts --network mstMainnet",
    "roles:local": "hardhat run scripts/grantRoles.ts --network localhost",
    "roles:mst-testnet": "hardhat run scripts/grantRoles.ts --network mstTestnet",
    "roles:mst-mainnet": "hardhat run scripts/grantRoles.ts --network mstMainnet",
    "verify:mst-testnet": "hardhat run scripts/verify.ts --network mstTestnet",
    "verify:mst-mainnet": "hardhat run scripts/verify.ts --network mstMainnet",
    "smoke:local": "hardhat run scripts/smokeTest.ts --network localhost",
    "smoke:mst-testnet": "hardhat run scripts/smokeTest.ts --network mstTestnet",
    "handover:mst-mainnet": "hardhat run scripts/handover.ts --network mstMainnet",
    "slither": "bash scripts/slither.sh",
    "aderyn": "bash scripts/aderyn.sh"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.0",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.11",
    "@nomicfoundation/hardhat-mocha": "^4.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-typechain": "^3.1.1",
    "@nomicfoundation/hardhat-verify": "^3.1.1",
    "@openzeppelin/hardhat-upgrades": "^4.1.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "chai": "^5.3.3",
    "ethers": "^6.17.0",
    "forge-std": "github:foundry-rs/forge-std#v1.16.2",
    "hardhat": "^3.18.0",
    "mocha": "^12.0.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0"
  }
}
